{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:c2o-universalis:human-capability-record:1.0.0",
  "title": "Portable Human Capability Evidence Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "subject",
    "capability",
    "proficiency",
    "status",
    "assessment",
    "evidence",
    "provenance",
    "consent",
    "independent_review",
    "attestation",
    "governance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "subject_type"
      ],
      "properties": {
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "subject_type": {
          "enum": [
            "human",
            "agent",
            "organization"
          ]
        },
        "display_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "domain",
        "taxonomy_ref",
        "description"
      ],
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "minLength": 1
        },
        "taxonomy_ref": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proficiency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "rubric_ref"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "rubric_ref": {
          "type": "string",
          "minLength": 1
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "status": {
      "enum": [
        "candidate",
        "evidenced",
        "qualified",
        "mastery_credentialed",
        "challenged",
        "suspended",
        "revoked",
        "expired"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "assessed_at",
        "assessed_by",
        "assessment_ref"
      ],
      "properties": {
        "method": {
          "enum": [
            "workout",
            "simulation",
            "field_task",
            "portfolio_review",
            "accessibility_audit",
            "peer_attestation",
            "other"
          ]
        },
        "assessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "assessed_by": {
          "type": "string",
          "minLength": 1
        },
        "assessment_ref": {
          "type": "string",
          "minLength": 1
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_id",
          "evidence_kind",
          "artifact_ref",
          "artifact_sha256",
          "occurred_at",
          "result"
        ],
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
            "enum": [
              "workout_receipt",
              "simulation_receipt",
              "field_task",
              "work_sample",
              "accessibility_evidence_pack",
              "audit_report",
              "peer_attestation",
              "other"
            ]
          },
          "artifact_ref": {
            "type": "string",
            "minLength": 1
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "partial",
              "informational"
            ]
          },
          "test_suite_sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[a-fA-F0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "submitted_by",
        "source_refs",
        "recorded_at"
      ],
      "properties": {
        "submitted_by": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_commit": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "purpose",
        "scope",
        "recorded_at",
        "record_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "granted",
            "not_required",
            "withdrawn"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "record_ref": {
          "type": "string",
          "minLength": 1
        },
        "withdrawn_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "independent_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewer_id",
        "reviewed_at",
        "review_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_reviewed",
            "passed",
            "failed",
            "disputed"
          ]
        },
        "reviewer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "review_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "proctor_authorized": {
          "type": "boolean"
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "issuer_id",
        "algorithm",
        "signature",
        "issued_at",
        "revocation_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "unsigned",
            "signed",
            "revoked"
          ]
        },
        "issuer_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "algorithm": {
          "enum": [
            "Ed25519",
            "none"
          ]
        },
        "signature": {
          "type": [
            "string",
            "null"
          ]
        },
        "issued_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "revocation_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_class"
      ],
      "properties": {
        "authority_class": {
          "enum": [
            "Evidence",
            "Advisory",
            "Controlled"
          ]
        },
        "policy_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "privacy_class": {
          "enum": [
            "public",
            "personal",
            "confidential"
          ]
        }
      }
    }
  }
}
